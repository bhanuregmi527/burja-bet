{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": ["**/*.proto"],
    "watchAssets": true,
    "builder": {
      "type": "swc",
      "options": {
        "copyFiles": true,
        "quiet": true,
        "sync": true,
        "outDir": "dist",
        "watch": true,
        "swcrcPath": ".swcrc"
      }
    },
    "plugins": [
      {
        "name": "@nestjs/swagger",
        "options": {
          "classValidatorShim": true,
          "introspectComments": true
        }
      }
    ]
  },
  "projects": {}
}
